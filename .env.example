# MosanTech EmailJS Configuration
# Sign up at https://www.emailjs.com/ and obtain these credentials:
# 1. Email Services -> Service ID
# 2. Email Templates -> Template ID
# 3. Account -> API Keys -> Public Key

VITE_EMAILJS_SERVICE_ID=service_mosantech
VITE_EMAILJS_TEMPLATE_ID=template_mosantech
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

